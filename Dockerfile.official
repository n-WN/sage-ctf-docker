ARG BASE_IMAGE=sagemath/sagemath:10.8
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

ARG UV_VERSION="0.9.21"
ARG MICROMAMBA_VERSION="2.4.0-1"
ARG RUST_TOOLCHAIN="stable"

ARG NODE_VERSION="24.12.0"
ARG NODE_SHA256_LINUX_X64=""
ARG NODE_SHA256_LINUX_ARM64=""
ARG BUN_VERSION="1.3.5"
ARG BUN_SHA256_LINUX_X64=""
ARG BUN_SHA256_LINUX_ARM64=""
ARG JADX_VERSION="1.5.3"
ARG JADX_SHA256=""

ARG FLATTER_REPO="https://github.com/keeganryan/flatter.git"
ARG FLATTER_REF=""
ARG RADARE2_REPO="https://github.com/radareorg/radare2.git"
ARG RADARE2_REF=""
ARG FLINT_REPO="https://github.com/flintlib/flint.git"
ARG FLINT_REF=""
ARG MSOLVE_REPO="https://github.com/algebraic-solving/msolve.git"
ARG MSOLVE_REF=""
ARG GF2BV_REPO="https://github.com/maple3142/gf2bv.git"
ARG GF2BV_REF=""
ARG LLL_CVP_REPO="https://github.com/maple3142/lll_cvp.git"
ARG LLL_CVP_REF=""
ARG CUSO_REPO="https://github.com/keeganryan/cuso.git"
ARG CUSO_REF=""
ARG FLATN_REPO="https://github.com/zksecurity/flatn.git"
ARG FLATN_REF=""
ARG YAFU_REPO="https://github.com/bbuhrow/yafu.git"
ARG YAFU_REF=""
ARG HASHCAT_REPO="https://github.com/hashcat/hashcat.git"
ARG HASHCAT_REF="v7.1.2"
ARG CRYPTO_ATTACKS_REPO="https://github.com/jvdsn/crypto-attacks.git"
ARG CRYPTO_ATTACKS_REF=""
ARG OR_TOOLS_REPO="https://github.com/google/or-tools.git"
ARG OR_TOOLS_REF=""

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    UV_HTTP_TIMEOUT=300 \
    HOME=/home/sage \
    MAMBA_ROOT_PREFIX=/opt/micromamba \
    CARGO_HOME=/home/sage/.cargo \
    RUSTUP_HOME=/home/sage/.rustup \
    PATH=/home/sage/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

SHELL ["/bin/bash", "-lc"]

USER root
RUN set -eux; \
  apt-get update; \
  apt-get install -y --no-install-recommends debconf-utils; \
  echo "wireshark-common wireshark-common/install-setuid boolean true" | debconf-set-selections; \
  apt-get install -y --no-install-recommends \
    ca-certificates curl wget git bash coreutils findutils xz-utils bzip2 unzip zip \
    python3 python3-venv python3-dev python3-setuptools \
    openjdk-17-jre-headless \
    make gcc g++ gfortran pkg-config autoconf automake libtool \
    libssl-dev libffi-dev libbz2-dev liblzma-dev zlib1g-dev \
    libreadline-dev libsqlite3-dev libncurses-dev libgdbm-dev libnsl-dev \
    cmake ninja-build \
    gdb strace ltrace bsdmainutils vim-common xxd file \
    libgmp-dev libecm-dev libmpfr-dev fplll-tools libfplll-dev libeigen3-dev libopenblas-dev \
    libm4ri-dev \
    ripgrep fd-find \
    tshark \
    netcat-openbsd \
    poppler-utils \
  ;

# Keep apt lists in the image so users can install extra packages without
# needing to `apt-get update` first (faster interactive usage).
RUN set -eux; \
  apt-get update

# Convenience: Ubuntu ships fd as `fdfind`; provide the common `fd` name.
RUN set -eux; \
  if command -v fdfind >/dev/null 2>&1; then \
    ln -sfn "$(command -v fdfind)" /usr/local/bin/fd; \
  fi; \
  command -v rg >/dev/null; \
  command -v fd >/dev/null

# Node.js (pinned, official tarball) + Bun (pinned, official release asset)
RUN set -eux; \
  arch="$(uname -m)"; \
  case "$arch" in \
    x86_64) node_arch="linux-x64"; node_sha="${NODE_SHA256_LINUX_X64}"; bun_arch="x64"; bun_sha="${BUN_SHA256_LINUX_X64}" ;; \
    aarch64|arm64) node_arch="linux-arm64"; node_sha="${NODE_SHA256_LINUX_ARM64}"; bun_arch="aarch64"; bun_sha="${BUN_SHA256_LINUX_ARM64}" ;; \
    *) echo "unsupported arch for node/bun: $arch" >&2; exit 1 ;; \
  esac; \
  node_file="node-v${NODE_VERSION}-${node_arch}.tar.xz"; \
  curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${node_file}"; \
  echo "${node_sha}  ${node_file}" | sha256sum -c -; \
  tar -xJf "${node_file}" -C /usr/local --strip-components=1 --no-same-owner; \
  rm -f "${node_file}"; \
  node --version; \
  npm --version; \
  bun_file="bun-linux-${bun_arch}.zip"; \
  curl -fsSL "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/${bun_file}" -o "${bun_file}"; \
  echo "${bun_sha}  ${bun_file}" | sha256sum -c -; \
  unzip -q "${bun_file}"; \
  install -m 0755 "bun-linux-${bun_arch}/bun" /usr/local/bin/bun; \
  rm -rf "${bun_file}" "bun-linux-${bun_arch}"; \
  bun --version

# JADX (pinned, CLI) - Java required (already installed)
RUN set -eux; \
  jadx_file="jadx-${JADX_VERSION}.zip"; \
  curl -fsSL "https://github.com/skylot/jadx/releases/download/v${JADX_VERSION}/${jadx_file}" -o "${jadx_file}"; \
  echo "${JADX_SHA256}  ${jadx_file}" | sha256sum -c -; \
  rm -rf /opt/jadx "/opt/jadx-${JADX_VERSION}"; \
  unzip -q "${jadx_file}" -d "/opt/jadx-${JADX_VERSION}"; \
  rm -f "${jadx_file}"; \
  ln -sfn "/opt/jadx-${JADX_VERSION}" /opt/jadx; \
  ln -sfn /opt/jadx/bin/jadx /usr/local/bin/jadx; \
  chmod 0755 /opt/jadx/bin/jadx; \
  jadx --help >/dev/null

# Create a stable symlink to Sage's Python venv (path includes the Python patch version).
RUN set -eux; \
  venv_root="$(/usr/bin/sage --python -c 'import sys, pathlib; print(pathlib.Path(sys.executable).resolve().parent.parent)')"; \
  ln -sfn "${venv_root}" /home/sage/sage/local/var/lib/sage/venv

# Flint 3.x (for msolve only; installed into its own prefix so it does not affect Sage).
RUN set -eux; \
  rm -rf /opt/src/flint; \
  git clone --no-tags --filter=blob:none "${FLINT_REPO}" /opt/src/flint; \
  cd /opt/src/flint; \
  if [ -n "${FLINT_REF}" ]; then git -c advice.detachedHead=false checkout "${FLINT_REF}"; fi; \
  rm -rf build; \
  cmake -S . -B build -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/flint-msolve; \
  cmake --build build -- -j"$(nproc)"; \
  cmake --install build

# msolve (built against the dedicated Flint prefix)
RUN set -eux; \
  rm -rf /opt/src/msolve; \
  git clone --no-tags --filter=blob:none "${MSOLVE_REPO}" /opt/src/msolve; \
  cd /opt/src/msolve; \
  if [ -n "${MSOLVE_REF}" ]; then git -c advice.detachedHead=false checkout "${MSOLVE_REF}"; fi; \
  ./autogen.sh; \
  PKG_CONFIG_PATH="/opt/flint-msolve/lib/pkgconfig:${PKG_CONFIG_PATH:-}" \
  CPPFLAGS="-I/opt/flint-msolve/include ${CPPFLAGS:-}" \
  LDFLAGS="-L/opt/flint-msolve/lib -Wl,-rpath,/opt/flint-msolve/lib ${LDFLAGS:-}" \
    ./configure --prefix=/usr/local; \
  make -j"$(nproc)"; \
  make install; \
  echo "/usr/local/lib" > /etc/ld.so.conf.d/msolve-local.conf; \
  ldconfig; \
  command -v msolve >/dev/null; \
  msolve -h >/dev/null

# Rust toolchain via rustup (official recommended installer).
RUN set -eux; \
  mkdir -p "${CARGO_HOME}" "${RUSTUP_HOME}"; \
  chown -R sage:sage "${CARGO_HOME}" "${RUSTUP_HOME}"

USER sage
RUN set -eux; \
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --profile minimal --no-modify-path --default-toolchain "${RUST_TOOLCHAIN}"; \
  rustup component add rustfmt clippy; \
  rustc --version; \
  cargo --version

USER root

# radare2 (r2) is not shipped in Ubuntu 22.04 apt repos; build from source for reproducibility.
RUN set -eux; \
  rm -rf /opt/src/radare2; \
  git clone --no-tags --filter=blob:none "${RADARE2_REPO}" /opt/src/radare2; \
  cd /opt/src/radare2; \
  if [ -n "${RADARE2_REF}" ]; then git -c advice.detachedHead=false checkout "${RADARE2_REF}"; fi; \
  sys/install.sh --prefix=/usr/local; \
  r2 -v >/dev/null

RUN set -eux; \
  rm -rf /opt/src/yafu; \
  if [ -n "${YAFU_REF}" ]; then \
    git init /opt/src/yafu; \
    git -C /opt/src/yafu remote add origin "${YAFU_REPO}"; \
    git -C /opt/src/yafu fetch --depth 1 origin "${YAFU_REF}"; \
    git -C /opt/src/yafu checkout --detach FETCH_HEAD; \
  else \
    git clone --depth 1 "${YAFU_REPO}" /opt/src/yafu; \
  fi; \
  mkdir -p /opt/src/gmp-install/6.2.0-gcc /opt/src/ecm-install/7.0.5-gcc; \
  ln -sfn /usr/include /opt/src/gmp-install/6.2.0-gcc/include; \
  ln -sfn /usr/lib/x86_64-linux-gnu /opt/src/gmp-install/6.2.0-gcc/lib; \
  ln -sfn /usr/include /opt/src/ecm-install/7.0.5-gcc/include; \
  ln -sfn /usr/lib/x86_64-linux-gnu /opt/src/ecm-install/7.0.5-gcc/lib; \
  cd /opt/src/yafu; \
  make -f Makefile.gcc -j"$(nproc)" ECM=1 yafu; \
  rm -rf /opt/tools/yafu; \
  mkdir -p /opt/tools/yafu; \
  cp -a yafu yafu.ini docfile.txt factor gnfs bin ggnfs-params-Gimarel.txt ggnfs-params-table.txt /opt/tools/yafu/; \
  ln -sfn /opt/tools/yafu/yafu /usr/local/bin/yafu; \
  yafu -v >/dev/null

# hashcat (password recovery tool)
RUN set -eux; \
  rm -rf /opt/src/hashcat; \
  if [ -n "${HASHCAT_REF}" ]; then \
    git init /opt/src/hashcat; \
    git -C /opt/src/hashcat remote add origin "${HASHCAT_REPO}"; \
    git -C /opt/src/hashcat fetch --depth 1 origin "${HASHCAT_REF}"; \
    git -C /opt/src/hashcat checkout --detach FETCH_HEAD; \
  else \
    git clone --depth 1 "${HASHCAT_REPO}" /opt/src/hashcat; \
  fi; \
  cd /opt/src/hashcat; \
  make -j"$(nproc)"; \
  make install; \
  hashcat --version >/dev/null

# rockyou.txt password dictionary
COPY rockyou.txt.tar.gz /tmp/rockyou.txt.tar.gz
RUN set -eux; \
  mkdir -p /usr/share/wordlists; \
  tar -xzf /tmp/rockyou.txt.tar.gz -C /usr/share/wordlists; \
  mv /usr/share/wordlists/rockyou.txt /usr/share/wordlists/rockyou.txt 2>/dev/null || true; \
  if [ -d "/usr/share/wordlists/rockyou.txt" ]; then \
    mv /usr/share/wordlists/rockyou.txt/rockyou.txt /usr/share/wordlists/rockyou.txt 2>/dev/null || true; \
  fi; \
  rm -f /tmp/rockyou.txt.tar.gz; \
  ls -lh /usr/share/wordlists/rockyou.txt || echo "Warning: rockyou.txt not found"

RUN set -eux; \
  arch="$(uname -m)"; \
  case "$arch" in \
    x86_64) uv_arch="x86_64-unknown-linux-gnu" ;; \
    aarch64|arm64) uv_arch="aarch64-unknown-linux-gnu" ;; \
    *) echo "unsupported arch for uv: $arch" >&2; exit 1 ;; \
  esac; \
  curl -LsS "https://github.com/astral-sh/uv/releases/download/${UV_VERSION}/uv-${uv_arch}.tar.gz" | tar -xz -C /usr/local/bin --strip-components=1; \
  uv --version

RUN set -eux; \
  arch="$(uname -m)"; \
  case "$arch" in \
    x86_64) mamba_arch="linux-64" ;; \
    aarch64|arm64) mamba_arch="linux-aarch64" ;; \
    *) echo "unsupported arch for micromamba: $arch" >&2; exit 1 ;; \
  esac; \
  curl -LsS "https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VERSION}/micromamba-${mamba_arch}.tar.bz2" | tar -xvj -C /usr/local/bin --strip-components=1 bin/micromamba; \
  micromamba --version

# Python 3.13 (primary) via uv-managed interpreter + venv
COPY requirements/py313.txt /tmp/requirements-py313.txt
RUN set -eux; \
  uv python install 3.13; \
  uv venv /opt/venvs/py313 --python 3.13; \
  uv pip install --python /opt/venvs/py313/bin/python -r /tmp/requirements-py313.txt; \
  PY313_REAL="$(readlink -f /opt/venvs/py313/bin/python)"; \
  PY313_PREFIX="$(dirname "$(dirname "$PY313_REAL")")"; \
  echo "${PY313_PREFIX}/lib" > /etc/ld.so.conf.d/uv-python3.13.conf; \
  ldconfig; \
  /opt/venvs/py313/bin/python -V

RUN set -eux; \
  chown -R sage:sage /opt/venvs/py313

# Provide a stable "CTF Python" shim that does NOT override `python3`
# (Sage's interactive REPL uses `#!/usr/bin/env python3`).
RUN set -eux; \
  mkdir -p /opt/ctf/bin; \
  printf '%s\n' '#!/usr/bin/env bash' 'exec /opt/venvs/py313/bin/python "$@"' > /opt/ctf/bin/python; \
  printf '%s\n' '#!/usr/bin/env bash' 'exec /opt/venvs/py313/bin/python "$@"' > /opt/ctf/bin/python3; \
  printf '%s\n' '#!/usr/bin/env bash' 'exec /opt/venvs/py313/bin/python -m pip "$@"' > /opt/ctf/bin/pip; \
  printf '%s\n' '#!/usr/bin/env bash' 'exec /opt/venvs/py313/bin/python -m pip "$@"' > /opt/ctf/bin/pip3; \
  chmod 0755 /opt/ctf/bin/python /opt/ctf/bin/python3 /opt/ctf/bin/pip /opt/ctf/bin/pip3

RUN set -eux; \
  cat > /opt/ctf/env.sh <<'EOF'
#!/usr/bin/env bash
export CTF_PY313=/opt/venvs/py313/bin/python
export CTF_PY27=/opt/micromamba/envs/py27/bin/python
export PATH=/opt/ctf/bin:/usr/local/sbin:/usr/local/bin:"$PATH"
if [ -n "${BASH_VERSION:-}" ]; then
  hash -r || true
fi
EOF

RUN set -eux; \
  chmod 0755 /opt/ctf/env.sh; \
  chown -R sage:sage /opt/ctf

# Ensure Sage keeps using its own Python3 even if the interactive shell maps `python3` to CTF Py3.13.
# We do this by wrapping `sage` and temporarily prepending Sage's venv bin (which contains python3)
# to PATH so that `#!/usr/bin/env python3` scripts (e.g. `sage-ipython`) resolve correctly.
RUN set -eux; \
  cat > /usr/local/bin/sage <<'EOF'
#!/usr/bin/env bash
export PATH="/home/sage/sage/local/var/lib/sage/venv/bin:/home/sage/sage/local/bin:${PATH}"
exec /usr/bin/sage "$@"
EOF

RUN set -eux; \
  chmod 0755 /usr/local/bin/sage

# When we auto-source the CTF env, `/opt/ctf/bin` becomes first on PATH. Provide a `sage` shim
# there so `sage` never resolves to `/home/sage/sage/src/bin/sage` (which ultimately runs
# `sage-ipython` via `#!/usr/bin/env python3`).
RUN set -eux; \
  ln -sfn /usr/local/bin/sage /opt/ctf/bin/sage

# The upstream `sagemath/sagemath` image uses an ENTRYPOINT that wraps all commands as
# `sage -sh -c ...`, which breaks the expectation that `docker run ... bash` starts a normal bash.
# Override ENTRYPOINT so shells and tools behave predictably in this CTF image.
RUN set -eux; \
  cat > /opt/ctf/entrypoint.sh <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

if [ "${CTF_AUTO_SOURCE:-1}" != "0" ] && [ -f /opt/ctf/env.sh ]; then
  # Ensure CTF python/pip are the defaults for any command (not just interactive bash).
  source /opt/ctf/env.sh
fi

if [ "${1:-}" = "sage-jupyter" ]; then
  shift
  exec sage -n jupyter --no-browser --ip='0.0.0.0' --port=8888 "$@"
fi

exec "$@"
EOF

RUN set -eux; \
  chmod 0755 /opt/ctf/entrypoint.sh; \
  chown sage:sage /opt/ctf/entrypoint.sh

# Source the CTF env in interactive shells by default.
# Disable by setting `CTF_AUTO_SOURCE=0`.
RUN set -eux; \
  # Base image appends a hard PATH reset at the end of ~/.bashrc, which breaks
  # Sage's runtime environment when entering the container with `bash`.
  python3 -c 'from pathlib import Path; p=Path("/home/sage/.bashrc"); lines=p.read_text().splitlines(); lines=[l for l in lines if not l.startswith("export PATH=/home/sage/sage/local/bin:")]; p.write_text("\n".join(lines)+"\n")'; \
  grep -qF 'CTF_AUTO_SOURCE' /home/sage/.bashrc || cat >> /home/sage/.bashrc <<'EOF'

# --- sage-ctf-docker: source CTF env (python -> py3.13) ---
case "$-" in
  *i*)
    if [ "${CTF_AUTO_SOURCE:-1}" != "0" ] && [ -f /opt/ctf/env.sh ]; then
      source /opt/ctf/env.sh
    fi
    ;;
esac
# ---------------------------------------------------------
EOF

# Python 2.7 (fallback) via micromamba
COPY requirements/py27.txt /tmp/requirements-py27.txt
RUN set -eux; \
  micromamba create -y -n py27 -c conda-forge python=2.7 pip gmpy2=2.0.8; \
  micromamba run -n py27 python -V; \
  micromamba run -n py27 python -m pip install --no-cache-dir --no-build-isolation --progress-bar off -r /tmp/requirements-py27.txt; \
  printf '#!/usr/bin/env bash\nexec micromamba run -n py27 python \"$@\"\n' > /usr/local/bin/py27; \
  printf '#!/usr/bin/env bash\nexec micromamba run -n py27 python \"$@\"\n' > /usr/local/bin/python2; \
  printf '#!/usr/bin/env bash\nexec micromamba run -n py27 python -m pip \"$@\"\n' > /usr/local/bin/pip2; \
  chmod +x /usr/local/bin/py27; \
  chmod +x /usr/local/bin/python2 /usr/local/bin/pip2; \
  ln -sfn /usr/local/bin/python2 /opt/ctf/bin/python2; \
  ln -sfn /usr/local/bin/pip2 /opt/ctf/bin/pip2; \
  ln -sfn /usr/local/bin/py27 /opt/ctf/bin/py27; \
  micromamba clean -a -y

RUN set -eux; \
  mkdir -p /home/sage/.cache/uv; \
  chown -R sage:sage /home/sage/.cache

RUN set -eux; \
  mkdir -p /opt/src /opt/verify /opt/patches; \
  mkdir -p /opt/work; \
  ln -sfn /opt/tools/yafu/yafu.ini /opt/work/yafu.ini; \
  ln -sfn /opt/tools/yafu/docfile.txt /opt/work/docfile.txt; \
  chown -R sage:sage /opt/src /opt/verify /opt/patches /opt/work

USER sage
WORKDIR /opt/work

ENTRYPOINT ["/opt/ctf/entrypoint.sh"]
CMD ["bash"]

RUN set -eux; \
  if [ -n "${FLATTER_REF}" ]; then \
    git init /opt/src/flatter; \
    git -C /opt/src/flatter remote add origin "${FLATTER_REPO}"; \
    git -C /opt/src/flatter fetch --depth 1 origin "${FLATTER_REF}"; \
    git -C /opt/src/flatter checkout --detach FETCH_HEAD; \
  else \
    git clone --depth 1 "${FLATTER_REPO}" /opt/src/flatter; \
  fi

USER root
RUN set -eux; \
  cmake -S /opt/src/flatter -B /opt/src/flatter/build -DCMAKE_BUILD_TYPE=Release; \
  cmake --build /opt/src/flatter/build -- -j"$(nproc)"; \
  cmake --install /opt/src/flatter/build; \
  ldconfig; \
  flatter -h >/dev/null

USER sage
RUN set -eux; \
  if [ -n "${GF2BV_REF}" ]; then \
    git init /opt/src/gf2bv; \
    git -C /opt/src/gf2bv remote add origin "${GF2BV_REPO}"; \
    git -C /opt/src/gf2bv fetch --depth 1 origin "${GF2BV_REF}"; \
    git -C /opt/src/gf2bv checkout --detach FETCH_HEAD; \
  else \
    git clone --depth 1 "${GF2BV_REPO}" /opt/src/gf2bv; \
  fi

RUN set -eux; \
  uv pip install --python /opt/venvs/py313/bin/python /opt/src/gf2bv; \
  /opt/venvs/py313/bin/python -c "from gf2bv import LinearSystem; lin=LinearSystem([1,1,1,1]); a,b,c,d=lin.gens(); assert lin.solve_one([a^b^c^1,b^d,a^c^1]) is not None"

RUN set -eux; \
  if [ -n "${CUSO_REF}" ]; then \
    git init /opt/src/cuso; \
    git -C /opt/src/cuso remote add origin "${CUSO_REPO}"; \
    git -C /opt/src/cuso fetch --depth 1 origin "${CUSO_REF}"; \
    git -C /opt/src/cuso checkout --detach FETCH_HEAD; \
  else \
    git clone --depth 1 "${CUSO_REPO}" /opt/src/cuso; \
  fi

RUN set -eux; \
  if [ -n "${FLATN_REF}" ]; then \
    git init /opt/src/flatn; \
    git -C /opt/src/flatn remote add origin "${FLATN_REPO}"; \
    git -C /opt/src/flatn fetch --depth 1 origin "${FLATN_REF}"; \
    git -C /opt/src/flatn checkout --detach FETCH_HEAD; \
  else \
    git clone --depth 1 "${FLATN_REPO}" /opt/src/flatn; \
  fi

RUN set -eux; \
  if [ -n "${LLL_CVP_REF}" ]; then \
    git init /opt/src/lll_cvp; \
    git -C /opt/src/lll_cvp remote add origin "${LLL_CVP_REPO}"; \
    git -C /opt/src/lll_cvp fetch --depth 1 origin "${LLL_CVP_REF}"; \
    git -C /opt/src/lll_cvp checkout --detach FETCH_HEAD; \
  else \
    git clone --depth 1 "${LLL_CVP_REPO}" /opt/src/lll_cvp; \
  fi

COPY patches/flatn-use-system-flatter.patch /opt/patches/flatn-use-system-flatter.patch
RUN set -eux; \
  cd /opt/src/flatn; \
  git apply /opt/patches/flatn-use-system-flatter.patch

RUN set -eux; \
  uv pip install --python /opt/venvs/py313/bin/python /opt/src/flatn; \
  /opt/venvs/py313/bin/python -c "import flatn; out=flatn.reduce([[1,0,331,303],[0,1,456,225],[0,0,628,0],[0,0,0,628]]); assert len(out)==4; print('ok: flatn (py313)')"

RUN set -eux; \
  if [ -n "${CRYPTO_ATTACKS_REF}" ]; then \
    git init /opt/src/crypto-attacks; \
    git -C /opt/src/crypto-attacks remote add origin "${CRYPTO_ATTACKS_REPO}"; \
    git -C /opt/src/crypto-attacks fetch --depth 1 origin "${CRYPTO_ATTACKS_REF}"; \
    git -C /opt/src/crypto-attacks checkout --detach FETCH_HEAD; \
  else \
    git clone --depth 1 "${CRYPTO_ATTACKS_REPO}" /opt/src/crypto-attacks; \
  fi

COPY patches/crypto-attacks-sage108.patch /opt/patches/crypto-attacks-sage108.patch
RUN set -eux; \
  cd /opt/src/crypto-attacks; \
  git apply /opt/patches/crypto-attacks-sage108.patch

RUN set -eux; \
  echo "/opt/src/crypto-attacks" > /opt/venvs/py313/lib/python3.13/site-packages/crypto_attacks.pth; \
  /opt/venvs/py313/bin/python -c "import attacks, shared; print('ok: crypto-attacks (py313)')"

RUN set -eux; \
  if [ -n "${OR_TOOLS_REF}" ]; then \
    git init /opt/src/or-tools; \
    git -C /opt/src/or-tools remote add origin "${OR_TOOLS_REPO}"; \
    git -C /opt/src/or-tools fetch --depth 1 origin "${OR_TOOLS_REF}"; \
    git -C /opt/src/or-tools checkout --detach FETCH_HEAD; \
  else \
    git clone --depth 1 "${OR_TOOLS_REPO}" /opt/src/or-tools; \
  fi

COPY requirements/sage.txt /tmp/requirements-sage.txt
RUN set -eux; \
  SAGE_PY="$(/usr/bin/sage --python -c 'import sys; print(sys.executable)')"; \
  uv pip install --python "${SAGE_PY}" -r /tmp/requirements-sage.txt; \
  :

RUN set -eux; \
  SAGE_PY="$(/usr/bin/sage --python -c 'import sys; print(sys.executable)')"; \
  uv pip install --python "${SAGE_PY}" /opt/src/flatn; \
  /usr/bin/sage --python -c "import flatn; out=flatn.reduce([[1,0,331,303],[0,1,456,225],[0,0,628,0],[0,0,0,628]]); assert len(out)==4; print('ok: flatn (sage)')"

RUN set -eux; \
  SAGE_PY="$(/usr/bin/sage --python -c 'import sys; print(sys.executable)')"; \
  uv pip install --python "${SAGE_PY}" /opt/src/lll_cvp; \
  /usr/bin/sage --python -c "import lll_cvp; print('ok: lll_cvp (sage)')"

RUN set -eux; \
  SAGE_PY="$(/usr/bin/sage --python -c 'import sys; print(sys.executable)')"; \
  uv pip install --python "${SAGE_PY}" /opt/src/cuso; \
  /usr/bin/sage --python -c "import cuso; print('ok: cuso (sage)')"

RUN set -eux; \
  echo "/opt/src/crypto-attacks" > /home/sage/sage/local/var/lib/sage/venv-python3.12.5/lib/python3.12/site-packages/crypto_attacks.pth; \
  /usr/bin/sage --python -c "import attacks, shared; print('ok: crypto-attacks (sage)')"

RUN set -eux; \
  cd /opt/src/crypto-attacks; \
  /usr/bin/sage --python -m unittest discover -s test -t . -v

USER root
COPY verify/smoke.sh /opt/verify/smoke.sh
RUN set -eux; \
  chmod 0755 /opt/verify/smoke.sh; \
  chown sage:sage /opt/verify/smoke.sh

USER root
WORKDIR /root

# Keep the default login directory clean for users; do not place
# any project assets under /root at build time.
RUN set -eux; \
  rm -rf /root/* /root/.[!.]* /root/..?* || true
